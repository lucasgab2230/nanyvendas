{
  "name": "@template/web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "exports": {
    ".": "./src/api/index.ts"
  },
  "scripts": {
    "build": "pnpm typecheck && vite build",
    "dev": "vite --host 0.0.0.0",
    "start": "tsx src/server.ts",
    "typecheck": "pnpm build:api && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "tsx src/server.ts",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "test": "pnpm build:api && tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "images:optimize": "node tools/optimize-images.mjs",
    "build:api": "node tools/build-api.mjs",
    "vercel-build": "pnpm build:api"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@libsql/client": "^0.17.2",
    "@orpc/client": "^1.14.7",
    "@orpc/server": "^1.14.7",
    "@orpc/tanstack-query": "^1.14.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@runablehq/website-runtime": "^0.10.0",
    "@tanstack/react-query": "^5.100.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.10",
    "lucide-react": "^0.577.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.2",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.20.0",
    "wouter": "^3.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.3.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.1.4",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.1-rc",
    "vite": "^7.3.1"
  }
}
